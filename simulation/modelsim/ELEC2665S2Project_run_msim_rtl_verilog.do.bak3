transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+D:/FPGATemp/QuartusProject/ELEC2665S2Project {D:/FPGATemp/QuartusProject/ELEC2665S2Project/ClockDivider.v}

vlog -vlog01compat -work work +incdir+D:/FPGATemp/QuartusProject/ELEC2665S2Project {D:/FPGATemp/QuartusProject/ELEC2665S2Project/ClockDivider_tb.v}
vlog -vlog01compat -work work +incdir+D:/FPGATemp/QuartusProject/ELEC2665S2Project {D:/FPGATemp/QuartusProject/ELEC2665S2Project/MainCode_tb.v}
vlog -vlog01compat -work work +incdir+D:/FPGATemp/QuartusProject/ELEC2665S2Project {D:/FPGATemp/QuartusProject/ELEC2665S2Project/ProgramCounter_tb.v}
vlog -vlog01compat -work work +incdir+D:/FPGATemp/QuartusProject/ELEC2665S2Project {D:/FPGATemp/QuartusProject/ELEC2665S2Project/Reverser_tb.v}
vlog -vlog01compat -work work +incdir+D:/FPGATemp/QuartusProject/ELEC2665S2Project {D:/FPGATemp/QuartusProject/ELEC2665S2Project/SevenSegEncoder_tb.v}
vlog -vlog01compat -work work +incdir+D:/FPGATemp/QuartusProject/ELEC2665S2Project {D:/FPGATemp/QuartusProject/ELEC2665S2Project/TimerCoreLogic_tb.v}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L fiftyfivenm_ver -L rtl_work -L work -voptargs="+acc"  ClockDivider_tb

add wave *
view structure
view signals
run -all
